# Stripe Connect embedded onboarding (Step 4 of /onboarding/[clientId]).
# Publishable keys are safe to expose client-side, but keep the live key out of source control
# regardless — set it directly in your hosting provider's environment config for production.
# Local development: copy this to .env.local (gitignored) with the sandbox/test key.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Secret key used server-only (src/app/api/onboarding/[clientId]/stripe-status/route.ts) to check
# an existing Stripe Connect account's real requirements/completion status. Never expose this to
# the browser — do not prefix it with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=
